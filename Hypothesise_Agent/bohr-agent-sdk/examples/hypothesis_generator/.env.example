# Copy this file to .env and fill in your API keys

# ─── DeepSeek API (required for LLM-powered hypothesis generation)
# Get your free key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# ─── Model to use (optional, default shown below)
# Options: deepseek/deepseek-chat, deepseek/deepseek-reasoner
MODEL=deepseek/deepseek-chat

# ─── Bohrium credentials (optional — only needed for Bohrium cloud compute jobs)
# Get from: https://bohrium.com/settings/user
BOHR_ACCESS_KEY=your_bohr_access_key_here
BOHR_APP_KEY=any_value_for_dev
